{
  "Serilog": {
    "MinimumLevel": {
      // In Production, only log Information and above — Debug is too noisy.
      "Default": "Information",
      "Override": {
        // Suppress framework internals completely in Production.
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  "ResetPassword": {
    "FrontendResetPasswordUrl": "https://ecommerce-sara.runasp.net/api/v1/users/confirm-reset-password"
  },

  "Jwt": {
    "Issuer": "https://ecommerce-sara.runasp.net",
    "Audience": "https://ecommerce-sara.runasp.net"
  },

  "AllowedHosts": "*"
}
